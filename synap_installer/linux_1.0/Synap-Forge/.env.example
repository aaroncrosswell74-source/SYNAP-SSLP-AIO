# SYNAP·FORGE — Example Environment
# Copy this file to .env and fill in your own values.

# === IDENTITY ===
AGENT_NAME=Meena
ASSISTANT=Meena
AGENT_GENDER=Female
USER_TAG=YourName
USER_NAME=YourName
CREATOR_NAME=YourName
USER_GENDER=Male
CONTENT_MODE=Adult

# === PROVIDER PRIORITY ===
PROVIDER_PRIORITY=gemini,llm

# === Google Gemini (GET YOUR OWN: https://aistudio.google.com/apikey) ===
GEMINI_API_KEY=your_key_here
LLM_MODEL=gemini-1.5-flash

# === LOCAL LLAMA.CPP ===
UPSTREAM_LLM=http://127.0.0.1:11435/v1
MODEL_NAME=qwen2.5-coder-1.5b-instruct

# === GENERATION ===
TEMPERATURE=1.0
MAX_TOKENS=1024
K_SELF=1.8
K_ENV=1.2

# === SERVER ===
PORT=11436
HOST=0.0.0.0
SYNAP_BASE_DIR=./

# === REDIS ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# === CHROMADB ===
CHROMA_HOST=localhost
CHROMA_PORT=8001

# === LOGGING ===
LOG_LEVEL=INFO
